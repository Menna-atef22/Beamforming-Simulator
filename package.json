{
  "name": "beam-weaver",
  "description": "Full-stack beamforming simulation application",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:frontend & npm run dev:backend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && python run_server.py",
    "build": "cd frontend && npm run build",
    "build:dev": "cd frontend && npm run build:dev",
    "preview": "cd frontend && npm run preview",
    "lint": "cd frontend && npm run lint",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm run test",
    "test:frontend:watch": "cd frontend && npm run test:watch",
    "test:backend": "cd backend && python -m pytest test_backend.py",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && pip install -r requirements.txt"
  },
  "keywords": [
    "beamforming",
    "simulation",
    "5G",
    "radar",
    "ultrasound",
    "antenna-arrays"
  ],
  "author": "",
  "license": "MIT"
}
